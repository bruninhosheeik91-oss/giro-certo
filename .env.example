# Variáveis públicas do frontend para integração com o Supabase.
# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto.
# Nunca inclua senha do banco ou service_role no frontend.

VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA

# Mantenha false até os produtos e o Google Play Billing estarem configurados.
VITE_SUBSCRIPTION_ENFORCEMENT=false

# APK direto: habilite somente após publicar e testar as Edge Functions da Stripe.
VITE_DISTRIBUTION_CHANNEL=direct
VITE_STRIPE_BILLING_ENABLED=false
VITE_GOOGLE_PLAY_BILLING_ENABLED=false

# Sem essas variáveis o app roda em MODO LOCAL (dados apenas no dispositivo),
# sem autenticação. Esse é o comportamento padrão em desenvolvimento.
